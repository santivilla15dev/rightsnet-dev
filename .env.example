APP_ENV=sandbox
# Live Stripe payments/Connect (technical gate). Default false; CI off.
# Requires PAYMENTS_PROVIDER=stripe. Does NOT unlock APP_ENV=production or legal pilot.
# See docs/LIVE_COMMERCE_V0_1.md — legal gates still in docs/launch-gates.md.
LIVE_COMMERCE_ENABLED=false
DATABASE_URL=postgresql://rightsnet@127.0.0.1:55432/rightsnet
API_PORT=4000
API_URL=http://127.0.0.1:4000
WEB_URL=http://localhost:3000
AUTH_PROVIDER=sandbox
# Producto del founder (signup + login reales): AUTH_PROVIDER=supabase
# más SUPABASE_URL + SUPABASE_ANON_KEY (Settings → API).
# Browser OAuth (Google/Apple) necesita las mismas keys públicas:
# NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY
# Redirects en Supabase: /auth/callback y /reset-password
# En desarrollo: desactiva “Confirm email” para sesión inmediata tras signup.
# E2E/CI fuerza AUTH_PROVIDER=sandbox en :3010/:4010; /demo solo para automatización.
# MFA TOTP (Supabase): MFA_ENABLED=true + AUTH_PROVIDER=supabase — docs/AUTH_MFA_V0_1.md
MFA_ENABLED=false
PAYMENTS_PROVIDER=sandbox
# Identity KYC: sandbox (default simulate) or stripe (Stripe Identity sessions).
IDENTITY_PROVIDER=sandbox
# IDENTITY_PROVIDER=stripe requires STRIPE_SECRET_KEY and Identity enabled in Dashboard.
# Test: sk_test_… / rk_test_…
# Live Identity only: IDENTITY_LIVE_ENABLED=true + sk_live_… (does NOT enable live commerce).
IDENTITY_LIVE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...   # required when PAYMENTS_PROVIDER=stripe or IDENTITY_PROVIDER=stripe
STRIPE_SECRET_KEY=
# Snapshot webhooks (Checkout, refunds, money, Identity): from `stripe listen --forward-to .../stripe`
STRIPE_WEBHOOK_SECRET=
# Thin Accounts v2 (optional; falls back to STRIPE_WEBHOOK_SECRET):
# stripe listen --thin-events '...' --forward-thin-to .../stripe/thin
STRIPE_THIN_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opt-in: require rightsnet.rights-policy/0.1 for newly created policies (evaluation dual-paths by schema_version regardless).
RIGHTS_CORE_PURCHASES=false
# RightsNet Connect (partner-gated /v1/platform/*). Off by default. Not Stripe Connect.
# When true, admin Bearer can call GET /v1/platform/search and POST /v1/platform/check.
PLATFORM_API_ENABLED=false
# Optional Higgsfield glue (authorize → sandbox|live HF → report). Off by default.
# CI/tests stay on sandbox (no network HF). Live keys: env only, never commit.
# HIGGSFIELD_ADAPTER_ENABLED=true
# HIGGSFIELD_MODE=sandbox
# Live L1 (optional local): HIGGSFIELD_MODE=live
# HIGGSFIELD_API_KEY_ID=
# HIGGSFIELD_API_KEY_SECRET=
# Or combined: HIGGSFIELD_API_KEY=keyId:keySecret
# HIGGSFIELD_API_BASE=https://api.higgsfield.ai
# HIGGSFIELD_MODEL_PATH=higgsfield-ai/soul/v2/standard
# HIGGSFIELD_POLL_TIMEOUT_MS=300000
# Nest L2: PLATFORM_API_ENABLED=true + HIGGSFIELD_ADAPTER_ENABLED →
#   POST /v1/platform/adapters/higgsfield/run
# L3 async + webhook:
#   POST /v1/platform/adapters/higgsfield/run-async
#   POST /v1/webhooks/higgsfield
# HIGGSFIELD_WEBHOOK_SECRET=
# HIGGSFIELD_WEBHOOK_PUBLIC_URL=https://your-api.example/v1/webhooks/higgsfield
# Existing Deal OCR live L3 (optional; CI stays sandbox extract):
# OCR_LIVE_ENABLED=true
# OCR_API_BASE=https://ocr.example.test
# OCR_API_KEY=
