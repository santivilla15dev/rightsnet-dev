# Staging host — plantilla (SIN secretos reales). Copiar al secret store del host.
# No usar APP_ENV=production. No activar LIVE_COMMERCE_ENABLED sin gates.
# docs/STAGING_HOST_SCAFFOLD_V0_1.md

APP_ENV=sandbox
LIVE_COMMERCE_ENABLED=false
DEMO_UI_ENABLED=false
IDENTITY_LIVE_ENABLED=false
MFA_ENABLED=false

# URLs públicas HTTPS del staging
WEB_URL=https://staging.example
API_URL=https://api.staging.example
WEB_ORIGINS=https://staging.example

# Auth producto
AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DB (host API); migrator ≠ app si usas roles
DATABASE_URL=postgresql://rightsnet_app:CHANGE_ME@db-host:5432/rightsnet
MIGRATE_DATABASE_URL=postgresql://rightsnet:CHANGE_ME@db-host:5432/rightsnet

# Stripe TEST only
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
IDENTITY_PROVIDER=stripe
CONNECT_DEFAULT_COUNTRY=at

# Firma / storage (ajustar al host)
SIGNING_PROVIDER=local
# SIGNING_KEYS_DIR=/var/rightsnet/keys
STORAGE_PROVIDER=local
MALWARE_SCAN_PROVIDER=sandbox
NOTIFY_PROVIDER=sandbox
PLATFORM_API_ENABLED=false
RIGHTS_CORE_PURCHASES=true
